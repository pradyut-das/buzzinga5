{
  "name": "itacorubi-kanban",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm kill && pnpm db:migrate && next dev -p 5800",
    "kill": "kill -9 $(lsof -ti :5800) || true",
    "build": "pnpm db:migrate && next build",
    "start": "next start -p 5800",
    "lint": "pnpm lint:types && pnpm lint:lint && pnpm lint:format && pnpm lint:unused",
    "lint:fix": "pnpm lint:types && pnpm lint:lint:fix && pnpm lint:format:fix && pnpm lint:unused",
    "lint:lint": "oxlint",
    "lint:lint:fix": "oxlint --fix",
    "lint:format": "oxfmt . --check",
    "lint:format:fix": "oxfmt .",
    "lint:unused": "knip",
    "lint:types": "next typegen && tsc --noEmit",
    "prepare": "husky",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx --env-file=.env scripts/seed-agency.ts",
    "db:import": "tsx --env-file=.env scripts/import-supabase.ts",
    "search:reindex": "tsx --env-file=.env scripts/search-backfill.ts",
    "verify:notifications": "tsx --env-file=.env scripts/verify-notifications.ts",
    "db:delete": "rm -f test.db test.db-journal",
    "db:reset": "pnpm db:delete && pnpm db:migrate",
    "test:reset": "pnpm kill && pnpm db:delete",
    "test": "playwright test --config=playwright/playwright.config.ts",
    "test:ui": "playwright test --config=playwright/playwright.config.ts --ui",
    "test:debug": "playwright test --config=playwright/playwright.config.ts --debug",
    "test:codegen": "playwright codegen http://localhost:5800"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@google/genai": "^2.15.0",
    "@libsql/client": "0.15.15",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@pipecat-ai/voice-ui-kit": "^0.13.0",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-label": "2.1.4",
    "@radix-ui/react-popover": "1.1.15",
    "@radix-ui/react-scroll-area": "1.2.10",
    "@radix-ui/react-select": "2.2.6",
    "@radix-ui/react-slot": "1.2.4",
    "@react-email/render": "^2.0.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.2",
    "@tanstack/react-query": "5.90.12",
    "@tanstack/react-query-devtools": "5.91.1",
    "@tiptap/core": "^3.14.0",
    "@tiptap/extension-image": "^3.13.0",
    "@tiptap/extension-link": "^3.14.0",
    "@tiptap/extension-mention": "^3.14.0",
    "@tiptap/extension-placeholder": "^3.14.0",
    "@tiptap/extension-task-item": "^3.14.0",
    "@tiptap/extension-task-list": "^3.14.0",
    "@tiptap/pm": "3.14.0",
    "@tiptap/react": "3.14.0",
    "@tiptap/starter-kit": "3.14.0",
    "@tiptap/suggestion": "^3.14.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "drizzle-orm": "0.45.1",
    "framer-motion": "^12.23.12",
    "jose": "^6.2.9",
    "lucide-react": "0.561.0",
    "next": "16.1.1",
    "next-themes": "0.4.6",
    "react": "19.2.3",
    "react-day-picker": "9.12.0",
    "react-dom": "19.2.3",
    "resend": "^6.6.0",
    "sonner": "2.0.7",
    "tailwind-merge": "3.4.0",
    "three": "^0.185.1",
    "zod": "^4.2.1",
    "zustand": "5.0.9"
  },
  "devDependencies": {
    "@playwright/test": "1.57.0",
    "@tailwindcss/postcss": "4.1.18",
    "@types/node": "20.19.26",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.185.4",
    "drizzle-kit": "0.31.8",
    "husky": "^9.1.7",
    "knip": "^5.78.0",
    "oxfmt": "^0.18.0",
    "oxlint": "^1.33.0",
    "postcss": "^8.5.6",
    "tailwindcss": "4.1.18",
    "tsx": "^4.23.5",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3"
  }
}
